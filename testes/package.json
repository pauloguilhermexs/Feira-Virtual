{
  "name": "feira-virtual-frontend-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Ferramentas de desenvolvimento (ESLint e Prettier) para o frontend da Feira Virtual",
  "scripts": {
    "lint:js": "eslint frontend/main.js frontend/js",
    "format:check": "prettier --check \"frontend/**/*.{js,css}\"",
    "format": "prettier --write \"frontend/**/*.{js,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.2"
  }
}
