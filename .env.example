# Django
DJANGO_SECRET_KEY=dev-inseguro-troque-em-producao
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Banco de Dados MySQL
DB_ENGINE=mysql
DB_NAME=feira_virtual
DB_USER=feira
DB_PASSWORD=feira123
DB_HOST=127.0.0.1
DB_PORT=3306

# Segurança e CORS (Permitir acesso de front-ends externos)
CORS_ALLOW_ALL_ORIGINS=1
# CORS_ALLOWED_ORIGINS=https://meufrontend.com,https://app.feira.com

# CSRF (Obrigatório para túneis HTTPS como Cloudflare, ngrok e domínios em nuvem)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.trycloudflare.com,https://*.ngrok-free.app

# Rate Limiting (Proteção contra força bruta e sobrecarga)
THROTTLE_ANON=100/minute
THROTTLE_USER=1000/minute
