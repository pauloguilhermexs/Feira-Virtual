# Configurações do Django
DJANGO_SECRET_KEY=dev-inseguro-troque-em-producao
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Configuração do Banco de Dados
# Defina DB_ENGINE=sqlite se desejar alternar para SQLite em testes
DB_ENGINE=mysql
DB_NAME=feira_virtual
